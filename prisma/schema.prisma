generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  client    String?
  color     String   @default("#1E4FFF")
  startDate DateTime
  endDate   DateTime
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  tasks     Task[]
  // Flujo de branding (Brief → Concepto → Investigación → Moodboard →
  // Desarrollo → Presentación), opcional por proyecto
  brand         BrandWorkspace?
  brandItems    BrandItem[]
  moodboards    Moodboard[]
  presentations Presentation[]
}

enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model GoogleAuth {
  id           String   @id @default("singleton")
  refreshToken String
  updatedAt    DateTime @updatedAt
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Responsable único (en desuso): se reemplazó por la relación de abajo,
  // que permite varios responsables por tarea. Se deja sin usar en el
  // código para no perder los datos existentes; se puede quitar más
  // adelante con otro `prisma db push`.
  assignedTasks Task[]         @relation("TaskAssignee")
  assignees     Task[]         @relation("TaskAssignees")
  notifications Notification[]
  comments      Comment[]
  brandItems    BrandItem[]
  references    Reference[]
}

model Task {
  id            String         @id @default(cuid())
  name          String
  status        Status         @default(TODO)
  startDate     DateTime
  endDate       DateTime
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  // En desuso, ver nota en User.assignedTasks
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignees     User[]         @relation("TaskAssignees")
  notifications Notification[]
  attachments   Attachment[]
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
}

model Attachment {
  id          String   @id @default(cuid())
  filename    String
  url         String
  pathname    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  @@index([userId, read])
}

// ─── Branding ────────────────────────────────────────────────────────────

// Textos largos de cada etapa del proyecto de branding (uno por proyecto)
model BrandWorkspace {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String   @unique
  stage        String   @default("brief")
  brief        String?
  context      String?
  conceptNotes String?
  plan         String?
  updatedAt    DateTime @updatedAt
}

// Cualquier pieza que se agrega dentro de una etapa: comentarios del
// cliente, archivos, referencias, conceptos, ideas, imágenes de moodboard,
// bocetos y piezas de desarrollo. `section` es la etapa y `kind` el tipo.
model BrandItem {
  id          String      @id @default(cuid())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  section     String
  kind        String
  title       String?
  body        String?
  url         String?
  pathname    String?
  contentType String?
  linkUrl     String?
  status      String?
  pinned      Boolean     @default(false)
  aiGenerated Boolean     @default(false)
  order       Int         @default(0)
  board       Moodboard?  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String?
  reference   Reference?  @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  referenceId String?
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, section])
}

model Moodboard {
  id        String      @id @default(cuid())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  notes     String?
  items     BrandItem[]
  createdAt DateTime    @default(now())
}

// Biblioteca de referencias del estudio, compartida entre proyectos.
// Las imágenes de un moodboard pueden venir de aquí (quedan ligadas).
model Reference {
  id          String      @id @default(cuid())
  title       String?
  url         String
  pathname    String?
  sourceUrl   String?
  tags        String[]    @default([])
  notes       String?
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  createdAt   DateTime    @default(now())
  usedIn      BrandItem[]
}

// Presentación armada a partir de las piezas del proyecto. `slides` guarda
// la secuencia de láminas como JSON (ver BrandSlide en src/lib/branding.ts).
model Presentation {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  slides    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
